{
  "name": "tim-video-tools",
  "version": "1.0.0",
  "description": "Recording tools for tristan.inmotion (T.im) videos, published with GitHub Pages at\r **https://chiefcrackt.github.io/inmotion-video/**",
  "scripts": {
    "test:responsive": "node tests/responsive.cjs",
    "test:hub": "node tests/hub.mjs",
    "build": "node activity-studio/build.mjs && node tests/check-static.mjs",
    "test": "node --test activity-studio/tests/*.test.mjs tests/sound.test.mjs tests/beat.test.mjs tests/idea-vault.test.mjs tests/docs-viewer.test.mjs tests/sync-controller.test.mjs carousel-maker/tests/model.test.mjs carousel-maker/tests/overflow.test.mjs tests/idea-vault-due.test.mjs tests/content-planner.test.mjs tests/project-drive.test.mjs",
    "test:browser": "node activity-studio/tests/browser.mjs && node tests/sound-browser.cjs",
    "preview": "node activity-studio/serve.mjs",
    "test:sound:browser": "node tests/sound-browser.cjs",
    "test:carousel": "node --test carousel-maker/tests/model.test.mjs carousel-maker/tests/overflow.test.mjs",
    "test:carousel:browser": "node carousel-maker/tests/browser.cjs",
    "test:carousel:editor": "node carousel-maker/tests/editor.cjs",
    "test:carousel:background": "node carousel-maker/tests/background.cjs",
    "test:carousel:stacking": "node carousel-maker/tests/stacking.cjs",
    "test:carousel:positioning": "node carousel-maker/tests/positioning.cjs",
    "format": "prettier --write \"**/*.{html,css,js,mjs,cjs,json}\"",
    "format:check": "prettier --check \"**/*.{html,css,js,mjs,cjs,json}\"",
    "test:carousel:all": "npm run test:carousel:browser && npm run test:carousel:editor && npm run test:carousel:background && npm run test:carousel:stacking && npm run test:carousel:positioning",
    "test:cover:browser": "node cover-maker/tests/render.cjs",
    "test:projects:browser": "node tests/projects-browser.cjs",
    "test:river:riverside": "node tests/river-riverside.cjs",
    "test:river:scenes": "node tests/river-riverside.cjs && node tests/river-riverside.cjs cyberpunk && node tests/river-riverside.cjs mountain && node tests/river-riverside.cjs night",
    "test:framer:browser": "node tests/video-framer.cjs",
    "test:exits:browser": "node tests/exits-intros.cjs",
    "test:desktop-save": "node tests/desktop-save.cjs",
    "test:carousel:ux": "node carousel-maker/tests/ux.cjs",
    "test:idea-vault": "node --test tests/idea-vault.test.mjs",
    "test:idea-vault:browser": "node tests/idea-vault-browser.cjs",
    "test:idea-vault:docs": "node --test tests/docs-viewer.test.mjs",
    "test:idea-vault:docs:browser": "node tests/idea-vault-docs-browser.cjs",
    "test:idea-vault:sync": "node --test tests/sync-controller.test.mjs",
    "test:idea-vault:auto-sync:browser": "node tests/idea-vault-auto-sync-browser.cjs",
    "test:idea-vault:due": "node --test tests/idea-vault-due.test.mjs",
    "test:idea-vault:due:browser": "node tests/idea-vault-due-browser.cjs",
    "test:planner": "node --test tests/content-planner.test.mjs && node tests/content-planner-browser.cjs",
    "test:drive": "node --test tests/project-drive.test.mjs && node tests/project-drive-browser.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chiefcrackt/inmotion-video.git"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/chiefcrackt/inmotion-video/issues"
  },
  "homepage": "https://github.com/chiefcrackt/inmotion-video#readme",
  "dependencies": {
    "@garmin/fitsdk": "^21.218.0",
    "@xmldom/xmldom": "^0.9.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "prettier": "3.9.10"
  },
  "private": true
}
